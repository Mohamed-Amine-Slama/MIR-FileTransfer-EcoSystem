{
  "name": "mir",
  "version": "0.1.0",
  "private": true,
  "description": "Cross-border medical imaging transfer platform (Libya -> Tunisia)",
  "engines": {
    "node": ">=20.0.0 <25"
  },
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter @mir/web test:e2e",
    "boundaries": "depcruise --config .dependency-cruiser.cjs apps/api/src",
    "boundaries:verify": "node scripts/verify-boundary-enforcement.mjs",
    "boundaries:graph": "depcruise --config .dependency-cruiser.cjs --output-type dot apps/api/src",
    "check:synthetic": "node test-data/check-synthetic.mjs",
    "gen:fixtures": "node test-data/generate-fixtures.mjs",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "verify": "pnpm check:synthetic && pnpm typecheck && pnpm lint && pnpm boundaries && pnpm boundaries:verify && pnpm test && pnpm build && pnpm check:bundle",
    "check:bundle": "node scripts/check-bundle-secrets.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@types/node": "^22.10.5",
    "dependency-cruiser": "^16.9.0",
    "eslint": "^9.18.0",
    "globals": "^15.14.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  }
}
