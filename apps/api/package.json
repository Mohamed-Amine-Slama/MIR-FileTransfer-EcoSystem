{
  "name": "@mir/api",
  "version": "0.1.0",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint \"src/**/*.ts\"",
    "start": "node dist/main.js",
    "dev": "tsx watch src/main.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "migrate:up": "tsx src/shared/db/migrate-cli.ts up",
    "migrate:down": "tsx src/shared/db/migrate-cli.ts down",
    "migrate:reset": "tsx src/shared/db/migrate-cli.ts reset"
  },
  "dependencies": {
    "@mir/contracts": "workspace:*",
    "@mir/dicom-utils": "workspace:*",
    "@nestjs/common": "^11.2.1",
    "@nestjs/core": "^11.2.1",
    "@nestjs/platform-express": "^11.2.1",
    "@types/pg": "^8.21.0",
    "dicom-parser": "^1.8.21",
    "dotenv": "^16.4.7",
    "jose": "^6.2.8",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sharp": "^0.35.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.2.3",
    "@swc/core": "^1.16.1",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.5",
    "@types/supertest": "^6.0.2",
    "eslint": "^9.18.0",
    "supertest": "^7.0.0",
    "tsx": "^4.23.12",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.68.0",
    "unplugin-swc": "^1.5.11",
    "vitest": "^4.1.11"
  }
}
